<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for CustomerPro Video (Electron + the engine's Node utility process,
     native skia-canvas, bundled ffmpeg). Used for the app and, as entitlementsInherit, for helpers. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- skia-canvas's .node addon and the ffmpeg binaries are signed with our identity at build time; this
       keeps loading them working if a dependency ships a binary with a different team id. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
